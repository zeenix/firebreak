+
+/// A note sealed ahead of its output opens once a later transaction publishes the token under the
+/// address, whatever that output's anchor, and gives back the opening its sender kept.
+#[test]
+fn a_prepared_output_opens_wherever_it_is_published() {
+    let account = account();
+    let address = account.address_at(util::RECEIVING, 1).expect("address");
+    let view_key = account
+        .viewing_key_at(util::RECEIVING, 1)
+        .expect("view key");
+    let spend_key = account
+        .spending_key_at(util::RECEIVING, 1)
+        .expect("spend key");
+    let mut output = native_output(address, 5_000);
+    output.memo = b"voucher 7".to_vec();
+    let prepared = crate::prepare_output(&output, &mut rng(60)).expect("prepare");
+
+    let published = Contract::new(
+        Predicate::opaque(address.spending_key().compress()),
+        Anchor([0x99; 32]),
+        Value::Token(prepared.token.clone()),
+    )
+    .expect("a token is portable");
+    let received =
+        open_note(&published, Some(&prepared.note), &address, &view_key).expect("the note opens");
+    assert_eq!(received.opening.qty, prepared.opening.qty);
+    assert_eq!(received.opening.flv, prepared.opening.flv);
+    assert_eq!(received.opening.qty_blinding, prepared.opening.qty_blinding);
+    assert_eq!(received.opening.flv_blinding, prepared.opening.flv_blinding);
+    assert_eq!(received.memo, b"voucher 7");
+    InputSpec::confidential(&published, &received.opening, Proof::Transient, spend_key)
+        .expect("the opening spends the output");
+
+    output.memo = vec![0; MEMO_MAX + 1];
+    assert!(matches!(
+        crate::prepare_output(&output, &mut rng(61)),
+        Err(BuilderError::MemoTooLong(_))
+    ));
+}
