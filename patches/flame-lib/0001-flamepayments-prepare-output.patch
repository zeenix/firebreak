     pub memo: Vec<u8>,
 }
 
+/// A confidential output sealed before the transaction that publishes it exists.
+///
+/// [`build_transfer`] seals and publishes an output in one step. A contract that pays a token out
+/// to its recipient only later needs the two apart: it locks the token together with its note,
+/// and emits both when it pays out. The note must then follow, in the very next `Data` entry, the
+/// output that locks the token under the address's spending key, where [`crate::open_note`] finds
+/// and opens it as for any other output.
+///
+/// Its `Debug` output shows only the note's length: the token's commitments carry their openings.
+#[derive(Clone)]
+pub struct PreparedOutput {
+    /// The token, with open commitments, for the transaction that creates it.
+    pub token: Token,
+    /// The note sealed to the output's address.
+    pub note: Vec<u8>,
+    /// The token's opening: what its creator keeps to spend or rebuild it. The recipient opens
+    /// the same one from `note`.
+    pub opening: Opening,
+}
+
+impl fmt::Debug for PreparedOutput {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("PreparedOutput")
+            .field("note_len", &self.note.len())
+            .finish_non_exhaustive()
+    }
+}
+
+/// Seals `output` without publishing it. Like every output of [`build_transfer`], it gets its own
+/// fresh, nonzero sender randomness, drawn from `rng`.
+pub fn prepare_output<R: RngCore + CryptoRng>(
+    output: &OutputSpec,
+    rng: &mut R,
+) -> Result<PreparedOutput, BuilderError> {
+    if output.memo.len() > MEMO_MAX {
+        return Err(BuilderError::MemoTooLong(output.memo.len()));
+    }
+    let r = Zeroizing::new(nonzero_scalar(rng));
+    let sealed = note::seal(&output.address, &r, output.qty, output.flv, &output.memo);
+    let opening = Opening {
+        qty: output.qty,
+        flv: output.flv,
+        qty_blinding: sealed.secrets.qty_blinding,
+        flv_blinding: sealed.secrets.flv_blinding,
+    };
+    let token = Token::from_opening(
+        Scalar::from(opening.qty),
+        opening.flv,
+        opening.qty_blinding,
+        opening.flv_blinding,
+    )
+    .expect("a u64 quantity is always inside the 64-bit range");
+    Ok(PreparedOutput {
+        token,
+        note: sealed.note,
+        opening,
+    })
+}
